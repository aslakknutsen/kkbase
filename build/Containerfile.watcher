# Build stage - Red Hat UBI9 with Go toolset
FROM registry.access.redhat.com/ubi9/go-toolset:1.21 AS builder

# Switch to root for build operations
USER root

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build watcher binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o watcher ./cmd/watcher

# Runtime stage - Red Hat UBI9 Minimal
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Install ca-certificates for HTTPS connections
RUN microdnf install -y ca-certificates && \
    microdnf clean all

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/watcher .

# Create non-root user
RUN useradd -u 1000 -r -s /sbin/nologin kkbase

# Set ownership and permissions
RUN chown -R kkbase:kkbase /app && \
    chmod +x /app/watcher

# Switch to non-root user
USER 1000

ENTRYPOINT ["./watcher"]


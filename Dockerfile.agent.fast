# Fast build - uses pre-built binary from local build
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Install ca-certificates for HTTPS connections (required for Gemini API)
RUN microdnf install -y ca-certificates && \
    microdnf clean all

WORKDIR /app

# Copy pre-built binary (must be built first with: go build -o agent ./cmd/agent)
COPY agent .

# Create non-root user
RUN useradd -u 1000 -r -s /sbin/nologin kkbase

# Set ownership and permissions
RUN chown -R kkbase:kkbase /app && \
    chmod +x /app/agent

# Switch to non-root user
USER 1000

# Expose HTTP port for webhooks and health checks
EXPOSE 8082

ENTRYPOINT ["./agent"]

